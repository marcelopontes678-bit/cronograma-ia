 "phrases": [
  {
   "scene": 1,
   "start": 0.25,
   "end": 2.804,
   "text": "O Brasil se prepara para mais uma decisão presidencial."
  },
  {
   "scene": 1,
   "start": 2.904,
   "end": 5.055,
   "text": "Mas o que devemos cobrar de quem quer governar?"
  },
  {
   "scene": 2,
   "start": 5.255,
   "end": 7.921,
   "text": "Escândalos políticos deixam perguntas importantes:"
  },
  {
   "scene": 2,
   "start": 8.021,
   "end": 9.383,
   "text": "quem foi responsabilizado,"
  },
  {
   "scene": 2,
   "start": 9.483,
   "end": 11.249,
   "text": "o que dizem as decisões judiciais"
  },
  {
   "scene": 2,
   "start": 11.349,
   "end": 13.796,
   "text": "e quais mecanismos podem impedir novos desvios?"
  },
  {
   "scene": 3,
   "start": 13.996,
   "end": 17.721,
   "text": "Conhecer os candidatos exige examinar suas propostas, seus históricos públicos,"
  },
  {
   "scene": 3,
   "start": 17.821,
   "end": 20.994,
   "text": "as evidências disponíveis e a viabilidade de seus compromissos."
  },
  {
   "scene": 4,
   "start": 21.194,
   "end": 23.983,
   "text": "Consulte as fontes, confira os fatos e cobre transparência."
  },
  {
   "scene": 4,
   "start": 24.083,
   "end": 26.531,
   "text": "Uma democracia exige cidadãos bem informados."
  }
 ],
