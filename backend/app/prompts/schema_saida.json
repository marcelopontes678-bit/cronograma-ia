{
  "name": "registrar_extracao",
  "description": "Registra os ambientes e modulos de marcenaria identificados nesta(s) pagina(s) do projeto, no formato de levantamento tecnico do MARC.",
  "strict": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "projeto_id": { "type": "string" },
      "ambientes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "nome_ambiente": { "type": "string" },
            "modulos": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "description": "Ex: 'MOD-001', unico dentro do job" },
                  "nome": { "type": "string" },
                  "vista_referencia": { "type": "string" },
                  "dimensoes": {
                    "type": "object",
                    "properties": {
                      "largura_mm": { "type": ["number", "null"] },
                      "altura_mm": { "type": ["number", "null"] },
                      "profundidade_mm": { "type": ["number", "null"] }
                    },
                    "additionalProperties": false,
                    "required": ["largura_mm", "altura_mm", "profundidade_mm"]
                  },
                  "componentes": {
                    "type": "object",
                    "properties": {
                      "portas": { "type": "integer" },
                      "gavetas": { "type": "integer" },
                      "prateleiras_internas": { "type": "integer" }
                    },
                    "additionalProperties": false,
                    "required": ["portas", "gavetas", "prateleiras_internas"]
                  },
                  "especificacoes_materiais": {
                    "type": "object",
                    "properties": {
                      "caixaria": { "type": "string" },
                      "frente": { "type": "string" },
                      "fundo": { "type": "string" },
                      "metodo_uniao": { "type": "string" },
                      "fixacao_fundo": { "type": "string" },
                      "campos_inferidos": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "Nomes dos campos acima que vieram das Preferencias Globais/regras, nao do desenho"
                      }
                    },
                    "additionalProperties": false,
                    "required": ["caixaria", "frente", "fundo", "metodo_uniao", "fixacao_fundo", "campos_inferidos"]
                  },
                  "ferragens_sugeridas": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "nome": { "type": "string" },
                        "quantidade": { "type": "integer" }
                      },
                      "additionalProperties": false,
                      "required": ["nome", "quantidade"]
                    }
                  },
                  "itens_complementares": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "nome": { "type": "string" },
                        "tipo": { "type": "string" }
                      },
                      "additionalProperties": false,
                      "required": ["nome", "tipo"]
                    }
                  },
                  "auditoria_visual": {
                    "type": "object",
                    "properties": {
                      "pagina_pdf": { "type": "integer" },
                      "arquivo_indice": {
                        "type": "integer",
                        "description": "Indice (comecando em 0) do arquivo de origem dentro deste job, na ordem em que foram enviados"
                      },
                      "bounding_box": {
                        "type": "array",
                        "items": { "type": "integer" },
                        "description": "[y_min, x_min, y_max, x_max] em pixels da imagem em que o modulo foi medido (a visao geral da pagina, ou o recorte indicado em recorte_rotulo), usando o tamanho informado no rotulo da imagem"
                      },
                      "recorte_rotulo": {
                        "type": ["string", "null"],
                        "description": "Quadrante do recorte de alta resolucao em que o bounding_box foi medido (ex: 'superior-esquerdo'); null quando medido na visao geral da pagina"
                      }
                    },
                    "additionalProperties": false,
                    "required": ["pagina_pdf", "arquivo_indice", "bounding_box"]
                  },
                  "descricao_resumida": { "type": "string" },
                  "confianca": {
                    "type": "number",
                    "description": "Confianca honesta da leitura, de 0 a 1 (ver secao 3 do prompt). < 0.7 para cotas ilegiveis, rotulos sobrepostos ou dimensoes inferidas por proximidade"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "id", "nome", "dimensoes", "componentes", "especificacoes_materiais",
                  "auditoria_visual", "confianca"
                ]
              }
            }
          },
          "additionalProperties": false,
          "required": ["nome_ambiente", "modulos"]
        }
      },
      "avisos": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Ambiguidades ou qualquer coisa que precise de revisao humana"
      }
    },
    "additionalProperties": false,
    "required": ["ambientes", "avisos"]
  }
}
