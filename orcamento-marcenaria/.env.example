# Copie este arquivo para .env e preencha os valores. Nunca comite o .env
# de verdade (com a chave real) -- .env ja deve estar no .gitignore.

# Obrigatoria para a API subir (validada no startup, ver api/main.py).
# Nunca cole a chave direto no codigo/chat -- gere em console.anthropic.com.
ANTHROPIC_API_KEY=

# Opcionais (defaults sensatos em api/config.py):
ORCAMENTO_MODELO_CLAUDE=claude-sonnet-5
ORCAMENTO_STORAGE_DIR=api/storage
ORCAMENTO_TABELA_PRECOS=config/tabela_precos_referencia.xlsx
ORCAMENTO_CONFIG_PRECIFICACAO=config/precificacao.json

# Usada pelo pipeline CLI (extractors/convert_dwg.py) e pelo Dockerfile --
# nao e lida por api/config.py. So precisa se dwg2dxf nao estiver no PATH.
DWG2DXF_PATH=
